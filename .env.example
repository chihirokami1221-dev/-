DATABASE_URL="file:./dev.db"

# Web版(Vercel等)。両方設定するとTurso(libSQL)へ接続する(アダプタ経由のため、
# その場合はDATABASE_URLは実際には使われない。未設定でもPrismaClientの構築は失敗しない)。
# 値はVercelの環境変数にのみ設定し、ここ(.env.example)には空のままにすること。
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ローカルAI(Ollama)。無料・ローカル実行。`ollama serve`が起動している必要がある。
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
# AIチャット(対話)専用の軽量モデル。CPUのみの環境でも応答が速い。
OLLAMA_CHAT_MODEL="qwen2.5:3b"

# 認証(自分専用アクセス制限)。値はここに実際の秘密情報をコピーしないこと。
# 生成方法は別途スクリプトでsalt/hash/session secretを作成して.envにのみ設定する。
AUTH_PASSWORD_SALT=""
AUTH_PASSWORD_HASH=""
AUTH_SESSION_SECRET=""

# Web版(Vercel等)でのみ"true"を設定し、ローカルのOllamaに依存するAI機能(チャット・日記分析・
# 実績抽出)を無効化する。ローカル開発では未設定のままでよい(未設定・true以外は常に有効)。
AI_FEATURES_DISABLED=""
